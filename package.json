{
  "name": "tessera",
  "productName": "Tessera",
  "version": "0.6.0",
  "description": "Local desktop password and key manager",
  "author": "shyunku",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "pack:win": "node scripts/pack.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "test:electron": "node scripts/test-electron.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "build": {
    "productName": "Tessera",
    "appId": "com.shyunku.tessera",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "electron/**/*",
      "build/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "include": "win-installer.nsh",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "shortcutName": "Tessera",
      "artifactName": "Tessera-Setup-${version}.exe"
    },
    "artifactName": "Tessera-Setup-${version}.exe",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
